class Solution {
    public int singleNumber(int[] nums) {
        HashMap<Integer,Integer> h1 = new HashMap<>();
        for(int i=0;i<nums.length;i++){
            h1.put(nums[i],h1.getOrDefault(nums[i],0)+1);
        }
        int val = 0;
        for(Map.Entry<Integer,Integer> entry : h1.entrySet()){
            if(entry.getValue()==1){
                val = entry.getKey();
            }
        }
        return val;
    }
}
