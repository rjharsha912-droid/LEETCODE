class Solution {
    public int sumOfGoodNumbers(int[] nums, int k) {
        int sum = 0;

        for(int i=0;i<nums.length;i++){
            boolean ans = true;
            if(i-k>=0){
                if(nums[i]<=nums[i-k]){
                    ans = false;
                }
            }
            if(i+k<nums.length){
                if(nums[i]<=nums[i+k]){
                    ans = false;
                }
            }
            if(ans){
                sum = sum+nums[i];
            }
        }
        return sum;
    }
}
