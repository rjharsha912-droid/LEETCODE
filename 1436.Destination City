class Solution {
    public String destCity(List<List<String>> paths) {
     HashSet<String> s1 = new HashSet<>();
     for(int i=0;i<paths.size();i++){
        s1.add(paths.get(i).get(0));
     }
     String a = "";
     for(int j=0;j<s1.size();j++){
if(!s1.contains(paths.get(j).get(1))){
a = paths.get(j).get(1);
     }
     }
     
     return a;
    }
}
