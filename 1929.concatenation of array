class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int ans_length = 2*n;
        
        int[] ans = new int[ans_length];
        for(int i=0;i<nums.length;i++){
            ans[i] = nums[i];
            ans[n+i] = nums[i];

        }
        return ans;
    }
}
