class Solution {
    public int[] numberGame(int[] nums) {
        Arrays.sort(nums);
        int[] arr = new int[nums.length];
        for(int i=0;i<nums.length;i=i+2){
           int j = i+1;
                arr[i] = nums[j];
                arr[j] = nums[i];
            
            
        }
        return arr;
    }
}
