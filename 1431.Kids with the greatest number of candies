class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {

       
        int max = candies[0];
        for(int i=1;i<candies.length;i++){
if(candies[i]>max){
    max = candies[i];
}
}
List<Boolean> ans = new ArrayList<>();
for(int i=0;i<candies.length;i++){
int candies_count = candies[i] + extraCandies;
if(candies_count >= max){
    ans.add(true);
}else{
    ans.add(false);
}
}
return ans;
        
    }
}
