class Solution {
    public boolean checkInclusion(String s1, String s2) {
        boolean ans = false;
        int k = s1.length();
        HashMap<Character,Integer> h1 = new HashMap<>();
        for(int i=0;i<s1.length();i++){
            char ch_1 = s1.charAt(i);
            h1.put(ch_1,h1.getOrDefault(ch_1,0)+1);
        }

        HashMap<Character,Integer> h2 = new HashMap<>();
        int lft = 0;
        for(int right=0;right<s2.length();right++){
char ch_2 = s2.charAt(right);
h2.put(ch_2,h2.getOrDefault(ch_2,0)+1);
if(right-lft+1==k){
    if(h1.equals(h2)){
  ans = true;
}

char remove = s2.charAt(lft);
h2.put(remove,h2.get(remove)-1);
lft++;
if(h2.get(remove)==0){
    h2.remove(remove);
}
}
}
        
        return ans;
    }
}
