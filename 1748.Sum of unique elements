class Solution {
    public int sumOfUnique(int[] nums) {
        HashMap<Integer,Integer> map = new HashMap<>();
        for(int num:nums){
            map.put(num,map.getOrDefault(num,0)+1);
        }
        int count = 0;
for(int key:map.keySet()){
    if(map.get(key)==1){
count = count+key;
    }
}
return count;
    }
}
