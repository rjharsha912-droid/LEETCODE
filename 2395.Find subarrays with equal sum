class Solution {
    public boolean findSubarrays(int[] nums) {
        int count = 0;
        int sum[] = new int[nums.length-1];
        int k = 0;
        for(int i=0;i<nums.length-1;i++){
            
                sum[k] = nums[i] + nums[i+1];
                k++;
            
        }
        boolean ans = false;
        for(int i=0;i<sum.length;i++){
            for(int j=i+1;j<sum.length;j++){
if(sum[i]==sum[j]){
ans = true;
            }
            
            }
        }
        return ans;
    }
}
