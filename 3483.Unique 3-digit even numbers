class Solution {
    public int totalNumbers(int[] arr) {
       
       HashSet<Integer> h1 = new HashSet<>();
       for(int i=0;i<arr.length;i++){
        for(int j=0;j<arr.length;j++){
            for(int k=0;k<arr.length;k++){
                if(i!=j && j!=k && k!=i){
                    if(arr[i]!=0){
                        if(arr[k]%2==0){
int num = arr[i]*100+arr[j]*10+arr[k];
h1.add(num);
                        }

                    }
                    
                }
            }
        }
       }
return h1.size();
    }
}
