class Solution {
    public int maxDepth(String s) {
        int count = 0;
        int max_count = 0;
        for(int i=0;i<s.length();i++){
if(s.charAt(i)=='('){
    count++;
    max_count = Math.max(count,max_count);
}else if(s.charAt(i) == ')'){
    count--;
}
        }
        return max_count;
    }
}
