class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {

        if(k <= 1) {
            return 0;
        }
        int ans = 0;
        for(int i = 0; i < nums.length; i++) {
    long sum = 1;

    for(int j = i; j < nums.length; j++) {
        sum *= nums[j];

        if(sum < k) {
            ans++;
        }
        else{
            break;
        }
    }
}
return ans;
    }
}
