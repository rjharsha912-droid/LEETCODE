class Solution {
    public int[] sortArrayByParity(int[] nums) {
        int n = nums.length;
    int[] ans = new int[n];
    int k =0;
     int count = 0;
    for(int i=0;i<nums.length;i++){
        if(nums[i]%2==0){
            ans[k] = nums[i];
            k++;
            
        }
    }
        for(int j=0;j<nums.length;j++){
            if(nums[j]%2!=0){
                ans[k] = nums[j];
                k++;
            }
        }
    
    return ans;
    }
}
